#!/usr/bin/env bash
# hackathon-kit hook: pre-push  (warns about rule problems; blocks only on secrets/.env)
ROOT=$(git rev-parse --show-toplevel)
[ -x "$ROOT/scripts/rules-check.sh" ] || exit 0
"$ROOT/scripts/rules-check.sh" --stage push --refs-from-stdin
rc=$?
if [ "$rc" -ne 0 ]; then
  echo "Push blocked. Fix the problem above, or bypass knowingly with: git push --no-verify"
fi
exit "$rc"
